# ==============================================================================
# Model Context Protocol (MCP) Configuration (.env)
# ==============================================================================

# OPTION 1: HTTP SSE Transport (Default)
MCP_SERVER_URL=http://localhost:3001/sse

# OPTION 2: Local Stdio Transport
# MCP_SERVER_PATH=./packages/server/dist/index.js

# Server Port and Transport Mode
PORT=3001
MCP_TRANSPORT=http

# ==============================================================================
# Authentication & Authorization (RBAC)
# ==============================================================================
# Active token used by Client and Host to authenticate against MCP Server
MCP_AUTH_TOKEN=admin-token-secret-123

# Pre-configured Role Directory:
# 1. Administrator (Role: admin) - Full access to all tools, resources, and delete actions
MCP_ADMIN_TOKEN=admin-token-secret-123

# 2. Developer / Standard User (Role: user) - Can use tools, create & read notes; cannot delete notes or view admin config
MCP_USER_TOKEN=user-token-secret-456

# 3. Guest / Read-Only (Role: guest) - Can calculate and read public notes; cannot create/delete notes or view system info
MCP_GUEST_TOKEN=guest-token-secret-789
