# ==============================================================================
# Model Context Protocol (MCP) Configuration (.env)
# ==============================================================================
# The MCP Client and MCP Host dynamically read these settings without hardcoding.

# OPTION 1: HTTP SSE Transport (Default)
# Point to any remote or local HTTP MCP Server SSE endpoint
MCP_SERVER_URL=http://localhost:3001/sse

# OPTION 2: Local Stdio Transport
# Uncomment below and comment out MCP_SERVER_URL to spawn the server over stdio
# MCP_SERVER_PATH=./packages/server/dist/index.js

# Server Port and Transport Mode for packages/server
PORT=3001
MCP_TRANSPORT=http
